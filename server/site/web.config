<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Bos birakilir. Yonetici parolasi kurulum sayfasinda App_Data/yonetici.json icine ozet olarak yazilir. -->
    <add key="siteAdi" value="Evse Bulut" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" requestValidationMode="2.0" maxRequestLength="64" enableVersionHeader="false" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="tr-TR" uiCulture="tr-TR" />
    <customErrors mode="RemoteOnly" />
    <authentication mode="None" />
    <sessionState mode="InProc" timeout="30" cookieless="false" cookieSameSite="Lax" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
    <pages validateRequest="true" controlRenderingCompatibilityVersion="4.0" />
    <httpHandlers>
      <add verb="*" path="api/device/poll" type="EvseBulut.YoklamaHandler" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; style-src 'self'; base-uri 'none'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <remove name="EvseYoklama" />
      <add name="EvseYoklama" path="api/device/poll" verb="*" type="EvseBulut.YoklamaHandler" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
    </handlers>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
